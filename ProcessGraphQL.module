<?php namespace ProcessWire;

use GraphQL\Error\DebugFlag;
use GraphQL\Error\Error;
use GraphQL\Executor\ExecutionResult;
use GraphQL\Server\Helper;
use GraphQL\Server\OperationParams;
use GraphQL\Server\RequestError;
use GraphQL\Server\ServerConfig;
use GraphQL\Server\StandardServer;
use GraphQL\Type\Schema as GraphQLSchema;
use GraphQL\Validator\Rules\QueryDepth;
use GraphQL\Validator\Rules\QueryComplexity;
use GraphQL\Validator\DocumentValidator;
use ProcessWire\GraphQL\Context;
use ProcessWire\GraphQL\Schema;
use ProcessWire\HookEvent;

class ProcessGraphQL extends Process implements Module {

	const pageName = 'graphql';

	public static function getModuleInfo()
	{
		return array(
			'title' => 'GraphQL',
			'version' => '2.0.0',
			'summary' => 'GraphQL for ProcessWire.',
			'href' => 'https://github.com/dadish/ProcessGraphql',
			'singular' => true,
			'autoload' => 'process=ProcessTemplate',
			'icon' => 'object-group',
      'requires' => array("PHP>=8.4", "ProcessWire>=3.0.210"),
			);
	}

	/**
	 * Bootstrap the module
	 */
	public function init()
	{
		$autoload = $this->config->paths->site . 'modules/ProcessGraphQL/vendor/autoload.php';
		if (file_exists($autoload)) require_once $autoload;
		$this->addHookAfter('Template::changed', $this, 'hookTemplateNameChange');
	}

	/**
   * The hook for modifying the GraphQL schema types by the user.
   * The schema is an array of types that will be set to GraphQL types.
   * Custom types could be added bu just appending them into an array.
   * See the documentation of the library used by this module to learn more
   * @see  The GraphQL lib https://github.com/webonyx/graphql-php
   * @param array $schema Schema config (`query`, `mutation`, ...)
   * @param Context|null $context Context the schema is built for
   * @return array
   */
	public function ___modifySchema($schema, ?Context $context = null) {
		return $schema;
	}

  /**
   * Updates the legalTemplates on name change. Template names for ProcessWire
   * are not necessarily valid for GraphQL field naming. Those names that are
   * not compatible are removed from legalFields, those that are compatible
   * are updated when changed.
   * @param  HookEvent $event ProcessWire hook $event object.
   */
	public function hookTemplateNameChange(HookEvent $event)
	{
		$whatChanged = $event->arguments[0];
		$oldName = $event->arguments[1];
		$newName = $event->arguments[2];

		// do nothing if name has not changed
		if ($whatChanged !== 'name') return;

		// do nothing if template is not in legalTemplates
		if (!in_array($oldName, $this->legalTemplates)) return;

		// remove the oldName from the legalTemplates
		$index = array_search($oldName, $this->legalTemplates);
		$legalTemplates = array_slice($this->legalTemplates, 0);
		array_splice($legalTemplates, $index, 1);
		$this->message("Removed `$oldName` from the legalTemplates.");

		// if newName is compatible with the module then add it into legalTemplates
		if (ProcessGraphQLConfig::isLegalTemplateName($newName)) {
			$legalTemplates[] = $newName;
			$this->message("Added `$newName` into legalTemplates.");
		}

		// make sure to remember changes!
		$this->modules->saveConfig($this, 'legalTemplates', $legalTemplates);
	}

  /**
   * Returns the GraphiQL GUI for ProcessWire admin when request's header is not
   * set to AJAX. Executes GraphQL api if it is AJAX.
   * @return string The rendered string of either GraphiQL GUI or GraphQL json
   * response
   */
  public function ___execute()
  {
    if ($this->config->ajax) {
    	$this->pages->setOutputFormatting(true);
    	return json_encode($this->executeGraphQL());
    }
		return $this->executeGraphiQLPartial();
  }

  /**
   * Returns a GraphiQL page.
   * @return string An HTML string.
   */
  public function executeGraphiQL()
  {
		$this->setupGraphiQLAssets();
    $fullFilename = $this->config->paths->site . 'modules/ProcessGraphQL/graphiql/full.php';
		return wireRenderFile($fullFilename, [
			'fullGraphiQL' => true,
		]);
  }

  /**
   * Returns only the necessary parts for the GraphiQL GUI.
   * @return string An HTML strin.
   */
	public function executeGraphiQLPartial()
	{
		$this->setupGraphiQLAssets();
		$partialFilename = $this->config->paths->site . 'modules/ProcessGraphQL/graphiql/partial.php';
		return wireRenderFile($partialFilename, [
			'fullGraphiQL' => false,
		]);
	}

  /**
   * Setups the GraphiQL js/css assets for ProcessWire to handle in the admin.
   */
	public function setupGraphiQLAssets()
	{
		$this->config->scripts->add("https://unpkg.com/react@18.2.0/umd/react.production.min.js");
		$this->config->scripts->add("https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js");
		$this->config->scripts->add('https://unpkg.com/graphiql@1.10.0/graphiql.min.js');
		$this->config->styles->add('https://unpkg.com/graphiql@1.10.0/graphiql.css');
		$this->config->js($this->className, [
			'GraphQLServerUrl' => $this->getGraphQLServerUrl(),
		]);
	}

  /**
   * Returns the server url from where the GraphiQL GUI will fetch the api.
   * @return string Url of the GraphQL server.
   */
	public function getGraphQLServerUrl()
	{
		$url = $this->GraphQLServerUrl;
		if (!$url) $url = $this->pages->get('template=admin, name=' . self::pageName)->url;
		return $url;
	}

	/**
	 * Parses the GraphQL request of the current HTTP request.
	 *
	 * Supports:
	 * - GET with `query`, `variables`, `operationName` (queries only, no mutations)
	 * - POST `application/json`, also batched as a JSON list (if enabled)
	 * - POST `application/graphql` (the body is the query)
	 * - POST form data (`application/x-www-form-urlencoded`, `multipart/form-data`)
	 *
	 * For backwards compatibility `payload` is accepted as alias of `query`.
	 *
	 * @param callable|null $readRawBody Returns the raw request body (default: php://input)
	 * @return OperationParams|OperationParams[]
	 * @throws RequestError
	 */
	public function getRequest(?callable $readRawBody = null): OperationParams|array
	{
		$method = strtoupper($_SERVER['REQUEST_METHOD'] ?? 'GET');
		$contentType = strtolower((string) ($_SERVER['CONTENT_TYPE'] ?? ''));
		$readRawBody ??= fn() => (string) file_get_contents('php://input');
		$bodyParams = [];

		if ($method === 'POST') {
			if (str_contains($contentType, 'application/json')) {
				$rawBody = $readRawBody();
				try {
					$bodyParams = $rawBody === '' ? [] : json_decode($rawBody, true, 512, JSON_THROW_ON_ERROR);
				} catch (\JsonException $e) {
					throw new RequestError('Could not parse JSON body: ' . $e->getMessage());
				}
				if (!is_array($bodyParams)) {
					throw new RequestError('GraphQL server expects a JSON object or array as request body.');
				}
			} elseif (str_contains($contentType, 'application/graphql')) {
				$bodyParams = ['query' => $readRawBody()];
			} else {
				$bodyParams = $_POST;
			}
		}

		$queryParams = self::withQueryAlias($_GET);
		$bodyParams = array_is_list($bodyParams) && $bodyParams
			? array_map(fn($op) => is_array($op) ? self::withQueryAlias($op) : $op, $bodyParams)
			: self::withQueryAlias($bodyParams);

		return (new Helper())->parseRequestParams($method, $bodyParams, $queryParams);
	}

	/**
	 * Maps the legacy `payload` parameter to `query`.
	 */
	private static function withQueryAlias(array $params): array
	{
		if (empty($params['query']) && !empty($params['payload'])) {
			$params['query'] = $params['payload'];
		}
		unset($params['payload']);
		return $params;
	}

	/**
	 * Executes the GraphQL request.
	 *
	 * With a $payload the given query is executed. Without it, the request is
	 * read from the current HTTP request (see getRequest()). Batched requests
	 * return a list of results.
	 *
	 * @param string $payload GraphQL query
	 * @param array|null $variables
	 * @param string|null $operationName
	 * @return array GraphQL response (`data`, `errors`), or a list of them for batches
	 */
	public function ___executeGraphQL($payload = "", $variables = null, $operationName = null)
	{
		// every execution gets its own context and schema
		$context = $this->createContext();

		try {
			$operations = $payload
				? OperationParams::create([
						'query' => $payload,
						'variables' => $variables,
						'operationName' => $operationName,
					])
				: $this->getRequest();

			$context->permissions->turnOnApiAccess();
			$result = $this->createServer($context)->executeRequest($operations);
		} catch (RequestError $e) {
			$result = new ExecutionResult(null, [Error::createLocatedError($e)]);
		}

		// the server already formats errors with the debug flag
		return is_array($result)
			? array_map(fn(ExecutionResult $r) => $r->toArray(), $result)
			: $result->toArray();
	}

	/**
	 * The graphql-php server for the given context: schema, root value (the
	 * $pages API variable), context value, validation rules, debug flag and
	 * query batching setting.
	 */
	public function ___createServer(Context $context): StandardServer
	{
		$config = ServerConfig::create()
			->setSchema($this->getSchema($context))
			// $pages is callable (Pages::__invoke), which the server would treat as a
			// root value factory, so it is wrapped in a real factory
			->setRootValue(fn() => $context->pages())
			->setContext($context)
			->setDebugFlag($this->getDebugFlag())
			->setQueryBatching((bool) $this->queryBatching);

		$validationRules = $this->getValidationRules();
		if ($validationRules !== null) {
			$config->setValidationRules($validationRules);
		}

		return new StandardServer($config);
	}

	/**
	 * Creates the state of one GraphQL execution, bound to this module's
	 * ProcessWire instance. Passed to every resolver as third argument.
	 */
	public function createContext(): Context
	{
		return new Context($this->wire(), $this);
	}

	/**
	 * Builds the GraphQL schema for the given context (its user's permissions).
	 */
	public function getSchema(?Context $context = null): GraphQLSchema
	{
		return Schema::build($context ?? $this->createContext());
	}

	/**
	 * Validation rules incl. the configured query depth and complexity limits.
	 *
	 * @return array|null Null for the graphql-php defaults
	 */
	public function getValidationRules(): ?array
	{
		$maxQueryDepth = (int) $this->maxQueryDepth;
		$maxQueryComplexity = (int) $this->maxQueryComplexity;
		if (!$maxQueryDepth && !$maxQueryComplexity) {
			return null;
		}
		$validationRules = DocumentValidator::allRules();
		if ($maxQueryDepth) $validationRules[] = new QueryDepth($maxQueryDepth);
		if ($maxQueryComplexity) $validationRules[] = new QueryComplexity($maxQueryComplexity);
		return $validationRules;
	}

	/**
	 * Debug details (message and trace) in errors only in debug mode.
	 */
	public function getDebugFlag(): int
	{
		return $this->wire()->config->debug
			? DebugFlag::INCLUDE_DEBUG_MESSAGE | DebugFlag::INCLUDE_TRACE
			: DebugFlag::NONE;
	}

  /**
   * The hook for modifying the GraphQL query operation fields by the user.
   * The queryFields is an array of fields that will be set to Query operation.
	 * Custom fields could be added bu just appending them into an array.
   * See the documentation of the library used by this module to learn more
   * @see  The GraphQL lib https://github.com/webonyx/graphql-php
   * @param array $queryFields
   * @param Context|null $context Context the schema is built for
   * @return array
   */
  public function ___getQueryFields($queryFields, ?Context $context = null)
  {
    return $queryFields;
  }

  /**
   * The hook for modifying the GraphQL mutation operation fields by the user.
   * The mutationFields is an array of fields that will be set to Mutation operation.
	 * Custom fields could be added bu just appending them into an array.
   * See the documentation of the library used by this module to learn more
   * @see  The GraphQL lib https://github.com/webonyx/graphql-php
   * @param array $mutationFields
   * @param Context|null $context Context the schema is built for
   * @return array
   */
  public function ___getMutationFields($mutationFields, ?Context $context = null)
  {
    return $mutationFields;
  }

	/**
	 * Install the module page under setup
	 */
	public function ___install()
	{
		// create the page
		$page = new Page();
		$page->template = 'admin';
		$page->name = self::pageName;

		// set parent to the home->admin->setup
		$parent = $this->pages->get($this->config->adminRootPageID)->child("name=setup, include=all");
		$page->parent = $parent;
		$page->process = $this->className;

		// set the page title as module title
		$info = self::getModuleInfo();
		$page->title = $info['title'];

		// save the page and tell the user about it
		$page->save();
		$this->message("Created page at: {$page->path}");

	}

  /**
   * Delete the module page
   */
	public function ___uninstall()
	{
		// find page by process field
		$moduleID = $this->modules->getModuleID($this);
		$page = $this->pages->get("process=$moduleID, name=" . self::pageName);

		// if the page exists then delete it and tell the user about it
		if ($page->id) {
			$this->message("Deleting page: {$page->path}");
			$page->delete();
		}
	}

}
